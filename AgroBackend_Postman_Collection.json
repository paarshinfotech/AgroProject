                "subscriptions",
                "plans",
                "{{planId}}"
              ]
            },
            "description": "Fetches a specific subscription plan by its unique ID."
          },
          "response": []
        },
        {
          "name": "4. Update Subscription Plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Price updated correctly\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.price).to.eql(1299);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planName\": \"Kisan Mitra Annual Plan (Discounted)\",\n  \"description\": \"Updated advisory plan with 24x7 agronomist phone support.\",\n  \"duration\": 12,\n  \"durationUnit\": \"MONTH\",\n  \"price\": 1299.00,\n  \"region\": \"MAHARASHTRA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions/plans/{{planId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscriptions",
                "plans",
                "{{planId}}"
              ]
            },
            "description": "Updates details such as price, description, duration, and region for an existing plan."
          },
          "response": []
        },
        {
          "name": "5. Toggle Plan Status (Enable/Disable)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions/plans/{{planId}}/status?enabled=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscriptions",
                "plans",
                "{{planId}}",
                "status"
              ],
              "query": [
                {
                  "key": "enabled",
                  "value": "true",
                  "description": "Set true to activate, false to deactivate"
                }
              ]
            },
            "description": "Enables or disables a subscription plan via query parameter `enabled`."
          },
          "response": []
        },
        {
          "name": "6. Deactivate Plan (Soft Delete)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Plan marked inactive\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.enabled).to.be.false;",
                  "    pm.expect(jsonData.status).to.eql(\"INACTIVE\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions/plans/{{planId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscriptions",
                "plans",
                "{{planId}}"
              ]
            },
            "description": "Soft deletes (deactivates) the subscription plan by setting enabled=false and status=INACTIVE."
          },
          "response": []
        }
      ]
    },
