{
  "info": {
    "_postman_id": "b73a9e34-5821-4d92-9387-a3f28f411cd3",
    "name": "AgroBackend API (No JWT - Direct Testing)",
    "description": "Comprehensive Postman collection for testing AgroBackend Subscription and Admin APIs without JWT authentication.\n\nAll security restrictions and JWT headers have been removed so all endpoints are directly accessible.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "planId",
      "value": "",
      "type": "string"
    },
    {
      "key": "subscriptionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Subscription Plans",
      "item": [
        {
          "name": "1. Create Subscription Plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"planId\", jsonData.id);",
                  "    console.log(\"Saved planId to collection variables:\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planName\": \"Kisan Mitra Annual Plan\",\n  \"description\": \"Comprehensive agricultural advisory, daily mandi prices, soil health reports, and weather alerts.\",\n  \"duration\": 12,\n  \"durationUnit\": \"MONTH\",\n  \"price\": 1499.00,\n  \"currency\": \"INR\",\n  \"enabled\": true,\n  \"region\": \"MAHARASHTRA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscriptions",
                "plans"
              ]
            },
            "description": "Creates a new subscription plan. Automatically stores the returned `id` in the `planId` variable."
          },
          "response": []
        },
        {
          "name": "2. Get All Subscription Plans",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(Array.isArray(jsonData)).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscriptions",
                "plans"
              ]
            },
            "description": "Retrieves the list of all subscription plans."
          },
          "response": []
        },
        {
          "name": "3. Get Subscription Plan By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Plan ID matches requested ID\", function () {",
                  "    var jsonData = pm.response.json();",
